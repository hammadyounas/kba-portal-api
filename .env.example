DATABASE_URL="postgresql://kba@127.0.0.1:5434/kba"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Storage (Step 2)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/private
# MinIO (optional — set STORAGE_DRIVER=minio)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=kba-documents
MINIO_ACCESS_KEY=kbaadmin
MINIO_SECRET_KEY=kbaadminsecret
MINIO_REGION=us-east-1
