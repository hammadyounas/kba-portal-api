DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_SECONDS="604800"
PORT=4000

# local keeps files on disk. Vercel must use minio (Supabase Storage S3).
STORAGE_DRIVER=minio
STORAGE_LOCAL_ROOT=./storage/private
MINIO_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
MINIO_BUCKET=kba-documents
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=ap-northeast-1
